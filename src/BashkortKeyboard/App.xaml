<Application x:Class="BashkortKeyboard.App"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" ShutdownMode="OnExplicitShutdown">
 <Application.Resources>
  <SolidColorBrush x:Key="Accent" Color="#147D72"/>
  <Style TargetType="TextBlock"><Setter Property="Foreground" Value="#172B32"/></Style>
  <Style TargetType="CheckBox">
   <Setter Property="FontSize" Value="14"/><Setter Property="VerticalContentAlignment" Value="Center"/>
   <Setter Property="Margin" Value="0,6"/><Setter Property="Foreground" Value="#243A42"/>
  </Style>
  <Style TargetType="Button">
   <Setter Property="Padding" Value="16,9"/><Setter Property="Background" Value="White"/>
   <Setter Property="Foreground" Value="#243A42"/><Setter Property="BorderBrush" Value="#D7E2E4"/>
   <Setter Property="Cursor" Value="Hand"/>
   <Setter Property="Template"><Setter.Value>
    <ControlTemplate TargetType="Button">
     <Border x:Name="Body" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="{TemplateBinding Padding}">
      <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
     </Border>
     <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Body" Property="Background" Value="#E6F2EF"/></Trigger>
      <Trigger Property="IsPressed" Value="True"><Setter TargetName="Body" Property="Opacity" Value="0.75"/></Trigger>
      <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Body" Property="BorderBrush" Value="#147D72"/></Trigger>
     </ControlTemplate.Triggers>
    </ControlTemplate>
   </Setter.Value></Setter>
  </Style>
  <Style x:Key="Card" TargetType="Border">
   <Setter Property="Background" Value="White"/><Setter Property="CornerRadius" Value="14"/>
   <Setter Property="Padding" Value="22"/><Setter Property="Margin" Value="0,0,0,14"/>
   <Setter Property="BorderThickness" Value="1"/><Setter Property="BorderBrush" Value="#E2EAEC"/>
  </Style>
 </Application.Resources>
</Application>
